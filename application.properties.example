# Example configuration file for Project Management System
# Copy this to application-local.properties or set environment variables

# Database Configuration (MySQL)
spring.datasource.url=jdbc:mysql://localhost:3306/project_manager?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your_secure_password
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

# Flyway Migrations
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# JWT Security
# Ensure this secret is at least 256 bits (32 characters) of cryptographically random characters
app.jwt.secret=change-this-to-a-very-long-secret-key-that-is-at-least-256-bits-long
app.jwt.expiration-ms=86400000

# File Storage Configuration
app.storage.location=./uploads
app.storage.max-file-size=10MB
app.storage.allowed-types=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,application/zip

# Team Configuration
app.team.min-size=2
app.team.max-size=4

# CORS (Frontend Origins)
app.cors.allowed-origins=http://localhost:3000,http://localhost:5173

# GitHub API Integration
app.github.token=your_github_personal_access_token_here
app.github.api-base-url=https://api.github.com

# Initial Coordinator Account Seed (Auto-bootstrapped on first run)
app.coordinator.seed.enabled=true
app.coordinator.seed.pnr=COORD001
app.coordinator.seed.email=coordinator@university.edu
app.coordinator.seed.password=Coordinator@123
app.coordinator.seed.name=Project Coordinator
app.coordinator.seed.department=Computer Science

# Server Settings
server.port=8080
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

